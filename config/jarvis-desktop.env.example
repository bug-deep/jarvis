# Пример. Реальный файл — config/jarvis-desktop.env (600), секреты — в secrets/.

CLOUD_PORT=8098
CLOUD_BIND=127.0.0.1
CLOUD_DB=./data/cloud.db
LOG_LEVEL=info

APP_PORT=8099
APP_BIND=127.0.0.1
CLOUD_URL=http://127.0.0.1:8098
APP_MODEL=deepseek-flash
AGENT_MAX_STEPS=12

USD_RUB=80
MARKUP=5
MIN_BALANCE_RUB=0.5
BONUS_RUB=30
DEVICE_CODE_TTL_SEC=600
OUTPUT_LIMIT=2048
RATE_LIMIT_PER_MINUTE=20

# Секреты (в git не попадают, в проекте — симлинк на ~/Harness/secrets/):
DEEPSEEK_API_KEY=
ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
ADMIN_TG_ID=
