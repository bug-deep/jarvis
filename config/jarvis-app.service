[Unit]
Description=Jarvis app (local agent: chat, files, commands)
After=network-online.target jarvis-cloud.service
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=andrey
WorkingDirectory=__ROOT__
Environment=HOME=/home/jarvis
Environment=JARVIS_OPEN=0
EnvironmentFile=__ROOT__/config/jarvis-desktop.env
ExecStart=/usr/bin/node __ROOT__/src/main.js app
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
